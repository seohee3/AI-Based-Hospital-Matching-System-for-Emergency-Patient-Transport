# 이 파일을 .env로 복사한 뒤 API 키와 서버 주소를 입력하세요.
# Windows:  copy .env.example .env     Mac/Linux:  cp .env.example .env
EXPO_PUBLIC_GROQ_API_KEY=여기에_gsk_로_시작하는_키

# B 서버에서 사용하는 키
KAKAO_API_KEY=여기에_카카오_REST_API_키
PUBLIC_API_KEY=여기에_응급의료기관_조회_서비스_인증키

# 아래 예시 IP를 B·C 서버를 실행하는 노트북의 Wi-Fi IPv4 주소로 변경하세요.
EXPO_PUBLIC_MATCH_URL=http://192.168.0.10:3000/api/match
EXPO_PUBLIC_CALL_URL=http://192.168.0.10:8082/api/calls

# 병원 PC에서 직접 응답할 때 manual, 한 기기 자동 시연은 demo
EXPO_PUBLIC_HOSPITAL_MODE=demo
